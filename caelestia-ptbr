#!/usr/bin/env python3
"""Traduz o Caelestia shell para pt-BR.

O quickshell não carrega catálogos de tradução (usa QQmlEngine puro, sem QTranslator),
então qsTr() sempre devolve a string do código-fonte. A única saída é editar o QML.

Estratégia: re-sincroniza a cópia do usuário a partir do original intocado em /etc/xdg
e reaplica a tradução por cima. Idempotente — rodar de novo dá sempre o mesmo resultado,
e é o que precisa acontecer depois de cada atualização do pacote caelestia-shell.
"""

import argparse
import re
import shutil
import sys
from pathlib import Path

SRC = Path("/etc/xdg/quickshell/caelestia")
