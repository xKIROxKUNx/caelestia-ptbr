def find_map(explicit=None):
    if explicit:
        path = Path(explicit).expanduser()
        if not path.is_file():
            sys.exit(f"erro: mapa não encontrado em {path}")
        return path
    for candidate in MAP_CANDIDATES:
        if candidate.is_file():
            return candidate
    sys.exit(
        "erro: nenhum mapa de tradução encontrado. Procurei em:\n  "
        + "\n  ".join(str(c) for c in MAP_CANDIDATES)
        + "\nUse --map CAMINHO para apontar um."
    )


def load_map(path):
    entries = []
    for lineno, raw in enumerate(path.read_text(encoding="utf-8").splitlines(), 1):
        if not raw.strip() or raw.lstrip().startswith("#"):
            continue
        if "\t" not in raw:
            print(f"aviso: {path.name}:{lineno} sem TAB, ignorada", file=sys.stderr)
            continue
        en, pt = raw.split("\t", 1)
        if en and pt and en != pt:
            entries.append((en, pt))
    # Do mais longo para o mais curto: evita que uma string curta seja consumida
    # antes de uma longa que a contenha.
    entries.sort(key=lambda e: len(e[0]), reverse=True)
    return entries


def sync():
    """Monta a árvore nova ao lado e só então troca, para não deixar o shell em execução
    sem arquivos. Apagar DST direto quebraria componentes carregados sob demanda."""
    if not SRC.is_dir():
        sys.exit(f"erro: {SRC} não existe — o caelestia-shell está instalado?")

    DST.parent.mkdir(parents=True, exist_ok=True)
    staging = DST.with_name(DST.name + ".new")
    previous = DST.with_name(DST.name + ".old")

    for leftover in (staging, previous):
        if leftover.exists():
            shutil.rmtree(leftover)

    shutil.copytree(SRC, staging)
    for p in staging.rglob("*"):
        p.chmod(p.stat().st_mode | 0o200)
    return staging, previous


def swap(staging, previous):
    if DST.exists():
        DST.rename(previous)
    staging.rename(DST)
    if previous.exists():
        shutil.rmtree(previous)


def qml_files(root):
    for path in sorted(root.rglob("*.qml")):
        if SKIP_DIRS & set(path.relative_to(root).parts):
            continue
        yield path


def apply_rules(root):
    applied = missed = 0
    for rel, old, new in RULES:
        path = root / rel
        if not path.is_file():
            print(f"  ! regra ignorada, arquivo sumiu: {rel}", file=sys.stderr)
            missed += 1
            continue
        text = path.read_text(encoding="utf-8")
        if old not in text:
            print(f"  ! regra não casou em {rel}: {old[:60]}...", file=sys.stderr)
            missed += 1
            continue
        path.write_text(text.replace(old, new), encoding="utf-8")
        applied += 1
    return applied, missed


def apply_map(root, entries):
    # Só o literal imediatamente dentro de qsTr( é trocado. Nenhuma string de lógica
    # (nome de ícone, chave de config, comando) pode ser atingida por engano.
    patterns = [
        (en, pt, re.compile(r'(qsTr\(\s*")' + re.escape(en) + r'(")'))
        for en, pt in entries
    ]
    hits = {en: 0 for en, _ in entries}
    changed_files = 0

    for path in qml_files(root):
        text = original = path.read_text(encoding="utf-8")
        for en, pt, pattern in patterns:
            text, n = pattern.subn(lambda m, pt=pt: m.group(1) + pt + m.group(2), text)
            hits[en] += n
        if text != original:
            path.write_text(text, encoding="utf-8")
            changed_files += 1

    return hits, changed_files


def main():
    parser = argparse.ArgumentParser(
        description="Traduz o Caelestia shell editando os literais do QML.",
        epilog="Sem --map, procura o mapa em ~/.local/share/caelestia-ptbr/pt_BR.tsv "
               "e depois ao lado do próprio script.",
    )
    parser.add_argument("--map", metavar="CAMINHO",
                        help="arquivo de tradução TSV (para outro idioma, por exemplo)")
    parser.add_argument("--dry-run", action="store_true",
                        help="mostra o que mudaria e descarta, sem tocar no shell")
    args = parser.parse_args()

    map_path = find_map(args.map)
    print(f"mapa: {map_path}")

    print(f"sincronizando {SRC} -> {DST}")
    staging, previous = sync()

    print("aplicando regras especiais")
    applied, missed = apply_rules(staging)
    print(f"  {applied} aplicadas, {missed} sem casar")

    entries = load_map(map_path)
    print(f"aplicando mapa ({len(entries)} strings)")
    hits, changed_files = apply_map(staging, entries)

    total = sum(hits.values())
    unused = [en for en, n in hits.items() if n == 0]
    print(f"  {total} substituições em {changed_files} arquivos")

    if unused:
        print(f"  {len(unused)} strings do mapa não encontradas no código:", file=sys.stderr)
        for en in unused:
            print(f"    - {en}", file=sys.stderr)
        print("  (o upstream provavelmente mudou o texto original)", file=sys.stderr)

    if args.dry_run:
        shutil.rmtree(staging)
        print(f"\n--dry-run: nada foi alterado. {DST} continua como estava.")
        return 0

    swap(staging, previous)
    print("\npronto. reinicie o shell:  caelestia shell -k && caelestia shell -d")
    return 1 if missed else 0


if __name__ == "__main__":
    sys.exit(main())
