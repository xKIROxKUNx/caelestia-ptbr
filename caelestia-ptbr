    Path.home() / ".local/share/caelestia-ptbr/pt_BR.tsv",
    Path(__file__).resolve().parent / "pt_BR.tsv",
]

# Fora do escopo: painel de configurações (524 das 819 ocorrências, quase tudo jargão).
